# Shared account-level secrets (same for every project/channel).
# Copy to .env and fill in. Channel-specific secrets go in projects/<slug>/.env
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
IMAGE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Full-featured ffmpeg build (drawtext/subtitles filters). Homebrew: brew install ffmpeg@7
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg@7/bin/ffmpeg

# Only if a channel uses presenter.provider = "higgsfield" (Higgsfield Speech2Video is hosted by Segmind;
# Higgsfield's own developer API has no lipsync endpoint). Default provider "omnihuman" runs on IMAGE_API_KEY.
SEGMIND_API_KEY=
# Only if a channel sets video.clipProvider = "higgsfield" (DoP cinematic clips via Higgsfield's official API,
# keys from cloud.higgsfield.ai). Default clips run on Replicate (Kling 2.5 Turbo Pro) with IMAGE_API_KEY.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_PASSWORD=            # what the client types to sign in
DASHBOARD_SESSION_SECRET=      # any long random string
DASHBOARD_URL=http://localhost:3777   # public URL used in notification links

# --- Notifications (both optional) ------------------------------------------
# Email via Resend (resend.com → API key; free tier is enough)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=               # one or more addresses, comma-separated
NOTIFY_EMAIL_FROM=             # optional, e.g. "Content Engine <engine@yourdomain.com>"
# Push notifications: generate with  npm run engine -- push-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Notion (per project, NOT here) -----------------------------------------
# Each client has their own Notion workspace, so the token is per project:
#
#   projects/<slug>/.env:
#     NOTION_TOKEN=ntn_...        internal integration token
#
# Setup for a client:
#   1. https://www.notion.so/my-integrations → New integration → copy the token
#   2. Paste it into projects/<slug>/.env as NOTION_TOKEN=
#   3. In Notion, open the page the hub should live under → ••• → Connections →
#      add the integration
#   4. engine notion setup <slug> --page <that page's URL>
#
# `engine notion setup` writes projects/<slug>/notion.json (gitignored) with the
# hub page + database ids. With no NOTION_TOKEN every Notion hook is a no-op.
