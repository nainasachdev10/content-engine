      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/activity",
      "regex": "^/activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/activity(?:/)?$"
